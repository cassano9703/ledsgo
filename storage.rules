rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default public read access for all files.
    match /{allPaths=**} {
      allow read;
    }
    
    // Restrict write access to the neon_jobs folder to authenticated admins.
    match /neon_jobs/{allPaths=**} {
      allow write: if request.auth != null && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
  }
}
